{
  "name": "gestion-creneaux-natation",
  "version": "1.0.0",
  "description": "Application de gestion des créneaux de natation pour club de triathlon",
  "main": "server.js",
  "scripts": {
    "start": "node migrate-blocs.js && node server.js",
    "dev": "nodemon --experimental-fetch server.js",
    "test": "jest --testPathPatterns=tests/backend",
    "test:e2e": "playwright test",
    "init-postgres": "node init-postgres.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "resend": "^6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
